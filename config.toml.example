# Nanofile configuration.
#
# Every key has a built-in default, and the web interface ("System Settings")
# manages every key except the file-only ones marked below. A value here is a
# bootstrap: it supplies a key with no saved value, and stops mattering for that
# key once an administrator saves one. The environment (NANOFILE_*) always wins
# and is never written back.
#
# So this file holds only (1) what the interface cannot store at all — the master
# secret, the database URL, the at-rest encryption mode, the first-start admin,
# the log file, each marked "file-only" — and (2) the values that have to be
# decided before the interface is reachable: external URL, listener, state
# directories, language. Everything else is edited at Settings → System Settings,
# where every row also names the NANOFILE_* variable that overrides it.

[server]
# External URL used for download and share links, and for the Secure cookie
# attribute and HSTS. Behind a proxy or TLS terminator set the address clients
# actually use, e.g. "https://your-domain.com".
#site_url = "http://127.0.0.1:8082"
# Listener address and port. Changing either needs a restart.
#addr = "0.0.0.0"
#port = 8082
# System tray icon; false runs headless (only in `--features tray` builds).
#tray = true
# file-only — master key: sessions, CSRF/notification tokens, sync-token
# encryption and (unless set separately) the at-rest block key are derived from
# it. A release build refuses to start without a strong value; generate one with
#   openssl rand -hex 32
# and keep this file private (chmod 600). Env: NANOFILE_SERVER_SECRET_KEY
secret_key = ""

[database]
# file-only — SQLite URL. A relative path resolves against the binary's
# directory (created if missing), never the working directory.
#url = "sqlite:data/nanofile.db?mode=rwc"
# file-only — pooled connections (WAL readers); kept modest on purpose.
#max_connections = 5

# [storage]
# State directories, relative to the binary's directory. Decide these before the
# first start: changing one afterwards does not move existing data.
#block_dir = "data/blocks"
#temp_dir = "data/temp"
#thumbnail_dir = "data/thumbnails"
#avatar_dir = "data/avatars"
# file-only — at-rest encryption of stored blocks: "off" / "on" / "lazy".
# Cannot be stored from the interface: it decides how existing ciphertext is
# read. "lazy" encrypts new writes while still reading legacy plaintext.
#block_encryption_mode = "off"
# file-only — dedicated key for at-rest encryption; unset derives it from
# [server] secret_key (prefer NANOFILE_STORAGE_ENCRYPTION_KEY_FILE).
#encryption_key = ...

# [index]
# Search index directory, relative to the binary's directory.
#index_dir = "data/index"

# [admin_init]
# file-only — create the first administrator on a start that finds no accounts
# (`nanofile adduser` is the alternative). Prefer the *_FILE variables
# (NANOFILE_ADMIN_INIT_PASSWORD_FILE) over these; they are not in a process list.
#email = "admin@example.com"
#password = "secret123"

# [ui]
# Fallback interface language when a visitor has no preference: "en" or "zh".
#default_language = "en"

# [logging]
# file-only — send logs to a size-capped rotating file instead of stdout. Unset
# chooses automatically: desktop (tray) runs log to a file, headless to stdout.
#file_enabled = true
#file = "nanofile.log"

[settings]
# How this file and the saved settings layer with each other. Not editable from
# the interface: it decides what a saved setting means. Order, highest first:
#   1. an environment variable (NANOFILE_*)
#   2. this file, for the keys named below
#   3. the value saved at "System Settings"
#   4. the built-in default
# "bootstrap" (the default) makes this file a first-start seed; "override" makes
# it win for every key it sets.
config_policy = "bootstrap"
# Keys this file still wins for under "bootstrap", e.g. ["server.site_url"].
#config_override_keys = []
# Seconds between re-reads of the saved settings, so a change made elsewhere (or
# restored from a backup) is picked up without a restart. 0 disables it.
#refresh_interval_secs = 30
